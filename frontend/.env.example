# Copy to .env (local) or set in Vercel → Settings → Environment Variables.
# CRA bakes these in AT BUILD TIME, so you must redeploy after changing them.

# No trailing slash.
REACT_APP_API_URL=http://localhost:8001

# Stripe publishable key (pk_test_... / pk_live_...). Safe in the browser.
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# OpenCage geocoding key.
# NOTE: anything prefixed REACT_APP_ is compiled into the JavaScript bundle and
# is therefore visible to anyone who opens the site. This variable only makes
# the key easy to rotate — it does not hide it. To actually protect the key,
# call OpenCage from the backend and have the frontend call your own endpoint.
REACT_APP_OPENCAGE_KEY=your-opencage-key
