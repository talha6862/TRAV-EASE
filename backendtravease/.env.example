# Copy this file to .env and fill in real values. Never commit .env.

# ---- database ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travease?retryWrites=true&w=majority

# ---- server ----
PORT=8001
NODE_ENV=development
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# ---- super admin (used by POST /auth/adminlogin) ----
SUPER_ADMIN_EMAIL=you@gmail.com
SUPER_ADMIN_PASSWORD=choose-a-strong-password

# ---- email (Gmail app password, not your account password) ----
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-gmail-app-password
# Where admin notifications are sent. Defaults to EMAIL_USER.
ADMIN_NOTIFY_EMAIL=you@gmail.com

# ---- payments ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

OPENCAGE_API_KEY=your-opencage-key
